{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.41/schema.json",
  "window_hiding_behaviour": "Cloak",
  "cross_monitor_move_behaviour": "Insert",
  "default_workspace_padding": 0,
  "default_container_padding": 0,
  "border": true,
  "border_width": 2,
  "border_offset": -1,
  "theme": {
    "palette": "Base16",
    "name": "Ashes",
    "unfocused_border": "Base03",
    "bar_accent": "Base0D"
  },

  "bars": [
    {
      "command": "komorebi-bar",
      "position": "Top",
      "height": 20,
      "font": "Bai Jamjuree",
      "font_size": 10,
      "tray_output": "All"
    }
  ],

  "whitelist": [],
  "blacklist": [],

"manage_rules": [
  { "kind": "Exe", "id": "MATLAB.exe" }
],
"float_rules": [
  { "kind": "Class", "id": "SunAwtFrame" },
  { "kind": "Class", "id": "ApplicationFrameWindow" },
  { "kind": "Class", "id": "AutoHotkeyGUI" },
  { "kind": "Class", "id": "AutoHotkey" },
  { "kind": "Exe", "id": "SnippingTool.exe" },
  { "kind": "Exe", "id": "AutoHotkeyUX.exe" },
  { "kind": "Exe", "id": "Spotify.exe" },
  { "kind": "Exe", "id": "NordVPN.exe" },
  { "kind": "Exe", "id": "EdgeBlock_x64.exe" },
  { "kind": "Title", "id": "Figure " }
],

  "monitors": [
    {
      "workspaces": [
        {
          "name": "㊀",
          "layout": "BSP"
        },
        {
          "name": "㊁",
          "layout": "BSP"
        },
        {
          "name": "㊂",
          "layout": "BSP"
        },
        {
          "name": "㊃",
          "layout": "BSP"
        }
      ]
    }
  ]
}



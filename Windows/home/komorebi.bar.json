{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.41/schema.bar.json",
  "font_family": "Bai Jamjuree",
  "theme": {
    "palette": "Custom",
    "colours": {
      "base_00": "#100C04",
      "base_01": "#111F3C",
      "base_02": "#657694",
      "base_03": "#8D8F8F",
      "base_04": "#657694",
      "base_05": "#F9F9F9",
      "base_06": "#FFCE5C",
      "base_07": "#F9F9F9",
      "base_08": "#8D8F8F",
      "base_09": "#FFCE5C",
      "base_0a": "#DFAE24",
      "base_0b": "#DFAE24",
      "base_0c": "#657694",
      "base_0d": "#DFAE24",
      "base_0e": "#FFCE5C",
      "base_0f": "#100C04"
    },
    "accent": "Base0D"
  },
  "left_widgets": [
    {
      "Komorebi": {
        "workspaces": {
          "enable": true,
          "hide_empty_workspaces": false
        },
        "layout": {
          "enable": true
        },
        "focused_window": {
          "enable": true,
          "show_icon": true
        }
      }
    }
  ],
  "right_widgets": [
    {
      "Update": {
        "enable": true
      }
    },
    {
      "Media": {
        "enable": true
      }
    },
    {
      "Storage": {
        "enable": false
      }
    },
    {
      "Memory": {
        "enable": false
      }
    },
    {
      "Network": {
        "enable": false,
        "show_activity": true,
        "show_total_activity": true
      }
    },
    {
      "Time": {
        "enable": true,
        "format": {
          "Custom": "%H:%M"
        }
      }
    },
    {
      "Date": {
        "enable": true,
        "format": {
          "Custom": "%d.%m"
        }
      }
    },
    {
      "Battery": {
        "enable": true
      }
    }
  ]
}